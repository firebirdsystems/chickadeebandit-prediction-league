{
  "scenarios": [
    {
      "name": "a sealed event hides every prediction but the member's own, and the reveal scores them all",
      "members": {
        "host": "admin",
        "player": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_prediction_league__events (id, title, description, type, options_json, unit, points, status, created_by, created_by_name, created_at) VALUES (?, ?, ?, 'number', ?, ?, 3, 'locked', ?, ?, datetime('now'))",
          "params": [
            "ui-e1",
            "How many jellybeans in the jar?",
            "Guess before Sunday",
            "[]",
            "jellybeans",
            "{{host}}",
            "Host"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_prediction_league__predictions (id, event_id, member_id, member_name, value, note, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'))",
          "params": [
            "ui-p1a",
            "ui-e1",
            "{{player}}",
            "Player",
            "180",
            "Gut feeling"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_prediction_league__predictions (id, event_id, member_id, member_name, value, note, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'))",
          "params": [
            "ui-p1b",
            "ui-e1",
            "{{host}}",
            "Host",
            "200",
            "Counted a corner and multiplied"
          ]
        },
        {
          "action": "open",
          "as": "player"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"event-card\"][data-event-id=\"ui-e1\"]",
          "as": "player"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"event-card\"][data-event-id=\"ui-e1\"][data-mine=\"yes\"]",
          "as": "player"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"event-card\"][data-event-id=\"ui-e1\"]",
          "as": "player"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"event-detail\"][data-event-id=\"ui-e1\"]",
          "as": "player"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"result-row\"]",
          "count": 0,
          "as": "player"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"sealed-note\"]",
          "as": "player"
        },
        {
          "action": "seedRaw",
          "sql": "UPDATE app_prediction_league__events SET status = 'revealed', correct_answer = ? WHERE id = ?",
          "params": [
            "250",
            "ui-e1"
          ]
        },
        {
          "action": "reload",
          "as": "player"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"event-card\"][data-event-id=\"ui-e1\"]",
          "as": "player"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"event-card\"][data-event-id=\"ui-e1\"]",
          "as": "player"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"results\"]",
          "as": "player"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"result-row\"]",
          "count": 2,
          "as": "player"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"result-answer\"]",
          "text": "250",
          "as": "player"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"result-row\"][data-won=\"yes\"]",
          "count": 1,
          "as": "player"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"results\"]",
          "text": "Counted a corner and multiplied",
          "as": "player"
        }
      ]
    },
